# ============================================================
# .env.example — Template biến môi trường
# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git
# ============================================================

# ----- Browser / Camoufox -----
# Thư mục lưu persistent browser profile (cookies, localStorage, session)
BROWSER_PROFILE_DIR=data/browser_profile

# Timeout mặc định (ms) cho điều hướng và thao tác trên trình duyệt
BROWSER_TIMEOUT=30000

# ----- Database -----
# Đường dẫn file SQLite (tương đối từ gốc dự án)
SQLITE_DB_PATH=data/scrap.db

# ----- HTTP -----
# Timeout (giây) cho mọi HTTP request
REQUEST_TIMEOUT=15.0

# ----- TikTok -----
TIKTOK_SESSION_ID=

# ----- Google Sheets -----
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT=service_account.json

# ----- Gmail -----
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ----- OpenAI / Gemini -----
GEMINI_API_KEY=
